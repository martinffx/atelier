{
  "name": "@martinffx/atelier",
  "version": "3.7.0",
  "description": "Personal development toolkit - spec-driven development, code quality, deep thinking, and ecosystem patterns",
  "type": "module",
  "bin": {
    "atelier": "dist/atelier.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/martinffx/atelier.git"
  },
  "keywords": [
    "cli",
    "claude-code",
    "opencode",
    "codex",
    "cursor",
    "ai-agents",
    "spec-driven-development"
  ],
  "license": "MIT",
  "files": [
    "dist/",
    "skills/",
    "agents/",
    ".codex-plugin/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun build ./src/atelier.ts --outdir ./dist --target bun",
    "clean": "rm -rf dist .agents .claude .codex .opencode hooks && rm -f *.log .DS_Store",
    "cli": "bun src/atelier.ts",
    "typecheck": "tsgo --noEmit",
    "test": "bun test",
    "prepare": "simple-git-hooks"
  },
  "simple-git-hooks": {
    "commit-msg": "npx --no -- commitlint --edit $1"
  },
  "dependencies": {
    "commander": "^13.1.0",
    "gray-matter": "^4.0.3",
    "inquirer": "^12.11.1",
    "smol-toml": "^1.9.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@types/bun": "^1.4.4",
    "@types/node": "^22.20.5",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "simple-git-hooks": "^2.14.0"
  }
}
